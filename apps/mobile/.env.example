# Expo loads .env from the Expo project directory, NOT from the monorepo root, so the
# EXPO_PUBLIC_* block also has to live here. Copy this file to apps/mobile/.env and
# keep the values in sync with the root .env.example (which stays the master list).

EXPO_PUBLIC_API_BASE=http://192.168.1.50:3000
EXPO_PUBLIC_AUTH0_DOMAIN=<tenant>.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=...
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.petplate.app

# Dev-only escape hatches (see src/lib/config.ts).
EXPO_PUBLIC_MOCK_API=false         # true → src/lib/mock serves every route, nothing hits the network
EXPO_PUBLIC_DEV_USER=              # e.g. dev@petplate.app → skips Auth0, sends x-dev-user
