{
  "name": "petplate",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r test",
    "lint": "echo 'no lint config yet'",
    "build:api": "pnpm --filter @petplate/shared build && pnpm --filter api build"
  }
}
