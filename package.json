{
  "name": "petplate",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build:shared": "pnpm --filter @petplate/shared build",
    "typecheck": "pnpm --filter @petplate/shared build && pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "dev:api": "pnpm --filter api dev",
    "start:mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
