# ===== apps/api =====
NODE_ENV=development
PORT=3000
DEMO_MODE=false                    # true → canned fallbacks for vision/avatar/voice (see ARCHITECTURE §7)
DEV_BYPASS_AUTH=false              # true (dev only) → header x-dev-user: <email> skips JWT verification

MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/petplate?retryWrites=true&w=majority

AUTH0_DOMAIN=<tenant>.us.auth0.com
AUTH0_AUDIENCE=https://api.petplate.app

XAI_API_KEY=xai-...
GROK_VISION_MODEL=grok-4.6         # VERIFY in console.x.ai — must accept image input
GROK_CHAT_MODEL=grok-4.6
GROK_IMAGE_MODEL=grok-imagine-image-2.0   # verified 2026-09-12 (Imagine docs)
GROK_VIDEO_MODEL=grok-imagine-video-1.5   # verified 2026-09-12 (Imagine docs)
GROK_VOICE_MODEL=grok-voice-latest        # realtime speech-to-speech only (stretch)
GROK_DEFAULT_VOICE=eve                    # voice_ids are lowercase; 'eve' is the xAI default
# NOTE: /v1/tts and /v1/stt take no model param, so GROK_TTS_MODEL / GROK_STT_MODEL were removed.

USDA_API_KEY=DEMO_KEY              # get a real key: https://fdc.nal.usda.gov/api-key-signup
NUTRITIONIX_APP_ID=                # optional fallback
NUTRITIONIX_APP_KEY=

# ===== apps/mobile (only EXPO_PUBLIC_* are bundled) =====
EXPO_PUBLIC_API_BASE=http://192.168.1.50:3000
EXPO_PUBLIC_AUTH0_DOMAIN=<tenant>.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=...
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.petplate.app
